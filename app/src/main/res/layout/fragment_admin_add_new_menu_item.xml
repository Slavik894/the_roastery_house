<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/admin_add_new_menu_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:text="Dodaj nową pozycję menu"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <ImageView
        android:id="@+id/admin_add_new_menu_item_image"
        android:layout_width="207dp"
        android:layout_height="207dp"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="80dp"
        android:src="@drawable/logo"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/admin_add_new_menu_item_vertical_line_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3"
        />

    <TextView
        android:id="@+id/admin_add_new_menu_item_item_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_title"
        app:layout_constraintLeft_toRightOf="@id/admin_add_new_menu_item_vertical_line_1"
        android:layout_marginTop="100dp"
        android:text="Nazwa pozycji:"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/admin_add_new_menu_item_vertical_line_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" 
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94"
        />
    
    <EditText
        android:id="@+id/admin_add_new_menu_item_et_item_name"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_title"
        app:layout_constraintRight_toLeftOf="@id/admin_add_new_menu_item_vertical_line_2"
        app:layout_constraintBaseline_toBaselineOf="@id/admin_add_new_menu_item_item_name_title"
        android:textSize="20sp"
        />

    <TextView
        android:id="@+id/admin_add_new_menu_item_category_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_item_name_title"
        app:layout_constraintLeft_toRightOf="@id/admin_add_new_menu_item_vertical_line_1"
        android:layout_marginTop="26dp"
        android:text="Kategoria:"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <Spinner
        android:id="@+id/admin_add_new_menu_item_category_name_spinner"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_et_item_name"
        app:layout_constraintRight_toLeftOf="@id/admin_add_new_menu_item_vertical_line_2"
        app:layout_constraintBaseline_toBaselineOf="@id/admin_add_new_menu_item_category_name_title"
        />

    <TextView
        android:id="@+id/admin_add_new_menu_item_sizes_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_add_new_menu_item_category_name_title"
        app:layout_constraintLeft_toRightOf="@id/admin_add_new_menu_item_vertical_line_1"
        android:layout_marginTop="30dp"
        android:text="Cena &amp; Rozmiary:"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <LinearLayout
        android:id="@+id/admin_add_new_menu_item_sizes_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/admin_add_new_menu_item_sizes_title"
        app:layout_constraintLeft_toRightOf="@id/admin_add_new_menu_item_sizes_title"
        app:layout_constraintRight_toLeftOf="@id/admin_add_new_menu_item_vertical_line_2"
        android:layout_marginStart="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <CheckBox
                android:id="@+id/cb_size_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textSize="20sp"/>
            <EditText
                android:id="@+id/input_price_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cena"
                android:textSize="20sp"
                android:inputType="numberDecimal"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <CheckBox
                android:id="@+id/cb_size_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:textSize="20sp"/>
            <EditText
                android:id="@+id/input_price_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cena"
                android:textSize="20sp"
                android:inputType="numberDecimal"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/cb_size_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:textSize="20sp"/>
            <EditText
                android:id="@+id/input_price_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cena"
                android:textSize="20sp"
                android:inputType="numberDecimal"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/admin_add_new_menu_item_single_price_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Cena"
        android:inputType="numberDecimal"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@id/admin_add_new_menu_item_sizes_title"
        app:layout_constraintLeft_toRightOf="@id/admin_add_new_menu_item_sizes_title"
        app:layout_constraintRight_toLeftOf="@id/admin_add_new_menu_item_vertical_line_2"
        android:layout_marginStart="16dp"
        />

    <Button
        android:id="@+id/admin_add_new_menu_item_btn_cancel"
        android:layout_width="324dp"
        android:layout_height="70dp"
        android:text="Anuluj"
        android:textSize="24sp"
        style="@style/CustomFormButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginBottom="36dp"
        android:layout_marginLeft="80dp"
        />

    <Button
        android:id="@+id/admin_add_new_menu_item_btn_save"
        android:layout_width="324dp"
        android:layout_height="70dp"
        android:text="Dodaj pozycję"
        android:textSize="24sp"
        style="@style/CustomFormButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="36dp"
        android:layout_marginRight="80dp"
        />




</androidx.constraintlayout.widget.ConstraintLayout>