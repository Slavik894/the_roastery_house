<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<TextView
    android:id="@+id/admin_settings_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Ustawienia"
    android:textSize="24sp"
    android:textStyle="bold"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    android:layout_marginTop="40dp"
    />
    <TextView
        android:id="@+id/admin_settings_password_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wpisz nowe hasło\nadmina"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="200dp"
        app:layout_constraintTop_toBottomOf="@id/admin_settings_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    
    <EditText
        android:id="@+id/et_admin_password"
        android:layout_width="450dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/admin_settings_password_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="10dp"
        />
    
    <Button
        android:id="@+id/admin_settings_cancel_btn"
        android:layout_width="320dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        style="@style/CustomFormButton"
        android:backgroundTint="@color/red"
        android:text="Anuluj"
        android:textSize="24sp"
        android:layout_marginBottom="22dp"
        android:layout_marginLeft="55dp"
        />

    <Button
        android:id="@+id/admin_settings_confirm_btn"
        android:layout_width="320dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/CustomFormButton"
        android:text="Zatwierdź"
        android:textSize="24sp"
        android:layout_marginBottom="22dp"
        android:layout_marginRight="55dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>