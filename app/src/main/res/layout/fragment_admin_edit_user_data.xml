<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/admin_edit_data_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:text="Edytuj informacje użytkownika"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/admin_edit_data_screen_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Imię"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_edit_data_screen_title"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <EditText
        android:id="@+id/admin_edit_data_screen_name_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_name_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <TextView
        android:id="@+id/admin_edit_data_screen_email_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_edit_data_screen_name_input"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <EditText
        android:id="@+id/admin_edit_data_screen_email_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_email_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
        android:id="@+id/admin_edit_data_screen_vertical_guideline_1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55"
        />

    <TextView
        android:id="@+id/admin_edit_data_screen_surname_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nazwisko"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_edit_data_screen_title"
        app:layout_constraintLeft_toLeftOf="@id/admin_edit_data_screen_vertical_guideline_1"
        />
    <EditText
        android:id="@+id/admin_edit_data_screen_surname_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_surname_title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginRight="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <TextView
        android:id="@+id/admin_edit_data_screen_password_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nowe hasło"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_edit_data_screen_surname_input"
        app:layout_constraintLeft_toLeftOf="@id/admin_edit_data_screen_vertical_guideline_1"
        />
    <EditText
        android:id="@+id/admin_edit_data_screen_password_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_password_title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginRight="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <Button
        android:id="@+id/admin_edit_data_screen_delete_user_button"
        android:layout_width="310dp"
        android:layout_height="90dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_email_input"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginLeft="80dp"
        style="@style/CustomFormButton"
        android:text="Usuń użytkownika"
        android:textSize="24sp"
        />

    <Button
        android:id="@+id/admin_edit_data_screen_discard_changes_button"
        android:layout_width="310dp"
        android:layout_height="90dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_delete_user_button"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="80dp"
        style="@style/CustomFormButton"
        android:text="Odrzuć zmiany"
        android:textSize="24sp"
        />

    <Button
        android:id="@+id/admin_edit_data_screen_reset_password_button"
        android:layout_width="310dp"
        android:layout_height="90dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_password_input"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginRight="80dp"
        style="@style/CustomFormButton"
        android:text="Zresetuj hasło użytkownika"
        android:textSize="24sp"
        />

    <Button
        android:id="@+id/admin_edit_data_screen_save_changes_button"
        android:layout_width="310dp"
        android:layout_height="90dp"
        app:layout_constraintTop_toBottomOf="@id/admin_edit_data_screen_reset_password_button"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginRight="80dp"
        style="@style/CustomFormButton"
        android:text="Zapisz zmiany"
        android:textSize="24sp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>