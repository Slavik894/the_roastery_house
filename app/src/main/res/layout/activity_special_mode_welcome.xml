<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.SpecialModeWelcomeActivity">

    <ImageView
        android:id="@+id/welcome_page_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="40dp"
        />

    <TextView
        android:id="@+id/welcome_page_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The roastery house"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcome_page_logo"
        android:layout_marginTop="40dp"
        android:textSize="36sp"
        android:textColor="@color/black"
        android:textFontWeight="700"
        />

    <TextView
        android:id="@+id/welcome_page_subheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Witamy w trybie specjalnym!\nTutaj możesz stworzyć własną kawę lub herbatę.
                      Nasi bariści są gotowi pomóc Ci w każdej chwili."
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcome_page_header"
        android:layout_marginTop="40dp"
        android:textSize="36sp"
        android:textColor="@color/black"
        android:textFontWeight="600"
        android:textAlignment="center"
        />

    <Button
        android:id="@+id/welcome_page_cancel_btn"
        android:layout_width="357dp"
        android:layout_height="100dp"
        style="@style/CustomFormButton"
        app:layout_constraintTop_toBottomOf="@id/welcome_page_subheader"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="80dp"
        android:layout_marginLeft="100dp"
        android:text="Anuluj"
        android:textSize="36sp"
        />

    <Button
        android:id="@+id/welcome_page_start_btn"
        android:layout_width="357dp"
        android:layout_height="100dp"
        style="@style/CustomFormButton"
        app:layout_constraintTop_toBottomOf="@id/welcome_page_subheader"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="80dp"
        android:layout_marginRight="100dp"
        android:text="Zaczynamy!"
        android:textSize="36sp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>