<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="10"
    tools:context=".activities.SpecialModeMainScreenActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sp_mode_left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:background="@color/left_right_panels_background"
        >

        <ImageView
            android:id="@+id/sp_mode_left_panel_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:background="@color/left_right_panels_background"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The roastery\n house"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@id/sp_mode_left_panel_logo"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="30dp"
            android:layout_marginRight="10dp"
            android:textSize="26sp"
            android:textFontWeight="700"
            android:background="@color/left_right_panels_background"
            />

        <Button
            android:id="@+id/sp_mode_left_panel_coffee_btn"
            android:layout_width="256dp"
            android:layout_height="60dp"
            style="@style/CustomFormButton"
            app:layout_constraintTop_toBottomOf="@id/sp_mode_left_panel_logo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="40dp"
            android:text="Kawa"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            />

        <Button
            android:id="@+id/sp_mode_left_panel_tea_btn"
            android:layout_width="256dp"
            android:layout_height="60dp"
            style="@style/CustomFormButton"
            app:layout_constraintTop_toBottomOf="@id/sp_mode_left_panel_coffee_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="10dp"
            android:text="Herbata"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            />

        <Button
            android:id="@+id/sp_mode_left_panel_desserts_btn"
            android:layout_width="256dp"
            android:layout_height="60dp"
            style="@style/CustomFormButton"
            app:layout_constraintTop_toBottomOf="@id/sp_mode_left_panel_tea_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="10dp"
            android:text="Desery"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            />


        <Button
            android:id="@+id/sp_mode_left_panel_exit_btn"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            style="@style/CustomFormButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginBottom="24dp"
            android:text="Wyjdź z trybu specjalnego"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="viewStart"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/sp_mode_center_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4.5"
        android:orientation="vertical"
        android:background="@color/main_background_color"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sp_mode_right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="@color/left_right_panels_background"
        >

        <TextView
            android:id="@+id/sp_mode_order_header"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:gravity="center"
            android:text="Zamówienie"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/functional_buttons_text_color"
            android:background="@color/menu_item_background"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sp_mode_right_panel_order_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/sp_mode_order_header"
            app:layout_constraintLeft_toLeftOf="@id/sp_mode_right_panel"
            app:layout_constraintRight_toRightOf="@id/sp_mode_right_panel"
            app:layout_constraintBottom_toTopOf="@id/sp_mode_right_panel_amount_title"
            android:layout_marginTop="24dp"
            android:background="@color/left_right_panels_background"
            />

        <TextView
            android:id="@+id/sp_mode_right_panel_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suma: "
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/sp_mode_add_drink_btn"
            app:layout_constraintLeft_toLeftOf="@id/sp_mode_summary_btn"
            android:layout_marginBottom="15dp"
            android:background="@color/left_right_panels_background"
            />

        <TextView
            android:id="@+id/sp_mode_right_panel_amount_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="@color/left_right_panels_background"
            app:layout_constraintBottom_toTopOf="@id/sp_mode_add_drink_btn"
            app:layout_constraintRight_toRightOf="@id/sp_mode_add_drink_btn"
            app:layout_constraintBaseline_toBaselineOf="@id/sp_mode_right_panel_amount_title"
            />
        
        <ImageButton
            android:id="@+id/sp_mode_add_drink_btn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            style="@style/CustomFormButton"
            app:layout_constraintBottom_toTopOf="@id/sp_mode_summary_btn"
            app:layout_constraintRight_toRightOf="@id/sp_mode_summary_btn"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_add"
            />

        <Button
            android:id="@+id/sp_mode_summary_btn"
            android:layout_width="270dp"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginBottom="24dp"
            style="@style/CustomFormButton"
            android:text="Podsumowanie"
            android:textSize="24sp"
            android:textStyle="bold"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>