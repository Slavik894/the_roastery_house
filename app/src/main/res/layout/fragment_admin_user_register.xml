<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/admin_user_register_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:text="Zarejestruj nowego użytkownika"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/admin_user_register_screen_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj imię użytkownika"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_user_register_screen_title"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <EditText
        android:id="@+id/admin_user_register_screen_name_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_user_register_screen_name_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <TextView
        android:id="@+id/admin_user_register_screen_email_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj email użytkownika"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_user_register_screen_name_input"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <EditText
        android:id="@+id/admin_user_register_screen_email_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_user_register_screen_email_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
        android:id="@+id/admin_user_register_screen_vertical_guideline_1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55"
        />

    <TextView
        android:id="@+id/admin_user_register_screen_surname_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj nazwisko użytkownika"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_user_register_screen_title"
        app:layout_constraintLeft_toLeftOf="@id/admin_user_register_screen_vertical_guideline_1"
        />
    <EditText
        android:id="@+id/admin_user_register_screen_surname_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_user_register_screen_surname_title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginRight="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />

    <TextView
        android:id="@+id/admin_user_register_screen_password_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj hasło użytkownika"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textFontWeight="500"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@+id/admin_user_register_screen_surname_input"
        app:layout_constraintLeft_toLeftOf="@id/admin_user_register_screen_vertical_guideline_1"
        />
    <EditText
        android:id="@+id/admin_user_register_screen_password_input"
        android:layout_width="354dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/admin_user_register_screen_password_title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginRight="80dp"
        android:textSize="24sp"
        android:textColor="@color/black"
        />
    
    <Button
        android:id="@+id/admin_user_register_screen_register_button"
        android:layout_width="350dp"
        android:layout_height="100dp"
        style="@style/CustomFormButton"
        app:layout_constraintTop_toBottomOf="@id/admin_user_register_screen_email_input"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="100dp"
        android:text="Zarejestruj użytkownika"
        android:textSize="24sp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>