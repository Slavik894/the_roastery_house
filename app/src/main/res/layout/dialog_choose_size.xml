<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/menu_item_background">
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wybierz rozmiar"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/menu_item_background"
        />

    <Button
        android:id="@+id/btn_size_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mały - 0.00 zł"
        style="@style/CustomFormButton"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_size_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Średni - 0.00 zł"
        style="@style/CustomFormButton"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_size_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Duży - 0.00 zł"
        style="@style/CustomFormButton"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CustomFormButton"
        android:text="Anuluj"
        android:backgroundTint="@color/red"
        />

</LinearLayout>